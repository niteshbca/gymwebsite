# ---------- Required ----------
# MongoDB connection string (local or Atlas). For multi-document transactions
# a replica set / Atlas cluster is required; the app also works without
# transactions using ordered fallback writes (documented in README).
MONGODB_URI=mongodb+srv://niteshkumarsingh1500_db_user:gHm3MCX6BWjkunUV@cluster0.ngqxhvn.mongodb.net/

# ---------- Auth ----------
# Random 32+ char strings. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-please
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-please
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Set to true in production (HTTPS)
COOKIE_SECURE=false

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Default gym timezone (IANA). Used for display + expiry-day boundaries.
APP_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# ---------- Email (SMTP) ----------
# Leave SMTP_HOST empty to run in "log-only" mode: emails are recorded in
# EmailLog with status "skipped_no_smtp" and NEVER reported as delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FitPro <no-reply@fitpro.local>"

# ---------- File uploads ----------
# local | cloudinary
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Payments ----------
# manual only by default. Configure a gateway adapter + webhook secret to
# enable online payments. Razorpay-style signature verification supported.
PAYMENT_GATEWAY=manual
PAYMENT_WEBHOOK_SECRET=

# ---------- Background jobs ----------
# Runs expiry transition + reminders inside the Next.js server process.
ENABLE_SCHEDULER=true
EXPIRY_REMINDER_WINDOWS_DAYS=7,3,1

# ---------- Security ----------
# Comma separated CORS/browser origins allowed for credentialed requests
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_LOGIN_PER_MIN=5
